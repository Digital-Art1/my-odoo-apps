<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_branch_tax_config_list" model="ir.ui.view">
        <field name="name">branch.tax.config.list</field>
        <field name="model">branch.tax.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="taxes_id"/>
            </list>
        </field>
    </record>

    <record id="view_company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <group name="branch_taxes" string="Default Sale Tax">
                    <field name="branch_default_tax_ids" widget="one2many" context="{'default_company_id': id}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
